# Ollama endpoint & model (defaults to http://localhost:11434/v1 and llama3.2)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional: GitHub personal access token (raises search rate limit from 10 to 30 req/min)
# GITHUB_TOKEN=ghp_your_token_here

# Optional: Telegram bot token from @BotFather (if running telegram_bot.py)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
